# Machine specific settings for the E2E harness. Copy to tool/test/local.env
# (gitignored) and fill in. Sourced by the scripts, never copied into the repo
# or a VM image; secrets only reach the build containers of a run.

# Each host only needs the secrets of its own platforms.

# Linux host: Android release signing (the update test needs the same key as
# the installed release). By default android/key.properties and the keystore
# its storeFile points to are used, set these only to sign differently.
ANDROID_KEYSTORE=""          # path to sheetopia.jks
ANDROID_KEY_PROPERTIES=""    # path to key.properties

# Mac host: Developer ID signing (the updater only accepts the same team ID).
# The identity must be in the login keychain; codesign asks once for access.
MACOS_CERTIFICATE_NAME="Developer ID Application: Julian Hofmann (B4J25Q656D)"

# Optional: higher GitHub API rate limit for downloading the previous release.
GITHUB_TOKEN=""
