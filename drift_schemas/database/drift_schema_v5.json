  "fixed_sql": [
    {
      "name": "scores",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"scores\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"composer\" TEXT NULL, \"notes\" TEXT NULL, \"search_text\" TEXT NOT NULL, \"recent_time\" TEXT NOT NULL GENERATED ALWAYS AS (MAX(last_opened, metadata_updated_at, file_updated_at)) VIRTUAL, \"last_opened\" TEXT NOT NULL, \"metadata_updated_at\" TEXT NOT NULL, \"file_updated_at\" TEXT NOT NULL, \"metadata_uploaded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"metadata_uploaded\" IN (0, 1)), \"file_uploaded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"file_uploaded\" IN (0, 1)), \"file_downloaded\" INTEGER NOT NULL CHECK (\"file_downloaded\" IN (0, 1)), \"file_type\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "genres",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"genres\" (\"score\" TEXT NOT NULL REFERENCES scores (id) ON UPDATE CASCADE ON DELETE CASCADE, \"genre\" TEXT NOT NULL, PRIMARY KEY (\"score\", \"genre\"));"
        }
      ]
    },
    {
      "name": "instruments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"instruments\" (\"score\" TEXT NOT NULL REFERENCES scores (id) ON UPDATE CASCADE ON DELETE CASCADE, \"instrument\" TEXT NOT NULL, PRIMARY KEY (\"score\", \"instrument\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"updated_at\" TEXT NOT NULL, \"uploaded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"uploaded\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "score_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"score_tags\" (\"score\" TEXT NOT NULL REFERENCES scores (id) ON UPDATE CASCADE ON DELETE CASCADE, \"tag\" TEXT NOT NULL REFERENCES tags (id) ON UPDATE CASCADE ON DELETE CASCADE, PRIMARY KEY (\"score\", \"tag\"));"
        }
      ]
    },
    {
      "name": "key_value",
      "sql": [
