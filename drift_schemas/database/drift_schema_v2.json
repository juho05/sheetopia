  "fixed_sql": [
    {
      "name": "scores",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"scores\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"composer\" TEXT NULL, \"search_text\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"metadata_updated_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"file_updated_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"downloaded\" INTEGER NOT NULL CHECK (\"downloaded\" IN (0, 1)), \"file_type\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "genres",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"genres\" (\"score\" TEXT NOT NULL REFERENCES scores (id) ON UPDATE CASCADE ON DELETE CASCADE, \"genre\" TEXT NOT NULL, PRIMARY KEY (\"score\", \"genre\"));"
        }
      ]
    },
    {
      "name": "instruments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"instruments\" (\"score\" TEXT NOT NULL REFERENCES scores (id) ON UPDATE CASCADE ON DELETE CASCADE, \"instrument\" TEXT NOT NULL, PRIMARY KEY (\"score\", \"instrument\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"updated_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "score_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"score_tags\" (\"score\" TEXT NOT NULL REFERENCES scores (id) ON UPDATE CASCADE ON DELETE CASCADE, \"tag\" TEXT NOT NULL REFERENCES tags (id) ON UPDATE CASCADE ON DELETE CASCADE, PRIMARY KEY (\"score\", \"tag\"));"
        }
      ]
    },
    {
      "name": "key_value",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"key_value\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "search_text_index",
